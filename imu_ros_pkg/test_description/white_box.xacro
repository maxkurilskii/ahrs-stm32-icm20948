<?xml version="1.0" ?>
<robot name="omnirobot" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:include filename="$(find imu_ros_pkg)/test_description/materials.xacro"/>
  <!--  base_link  -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <!-- <origin xyz="0 0 0.05" rpy="0 0 0"/> -->
      <geometry>
        <box size="0.2 0.2 0.2"/>
      </geometry>
      <material name="White"/>
    </visual>
  </link>
</robot>
